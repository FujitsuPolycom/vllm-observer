# vLLM Observer — environment configuration
# Copy to .env and edit:  cp .env.example .env

# ── Discovery ──────────────────────────────────────────────────────
# By default the observer discovers ALL Docker containers that look like
# LLM serving workloads (vllm, sglang, tgi, ollama, lmdeploy, etc.).
# No allowlist is needed unless you want to restrict discovery.

# Optional: restrict discovery to specific container names (comma-separated).
# When empty (default), all matching containers are discovered.
# VLLM_OBSERVER_CONTAINER_ALLOWLIST=glm52-v20-r7-exl3,ds4nvfp4test

# Optional: override the discovery keywords used to identify LLM containers.
# When empty (default), built-in terms are used: vllm, sglang, triton,
# tgi, ollama, lmcache, lmdeploy, tensorrt-llm, qwen, sparkring, etc.
# VLLM_OBSERVER_DISCOVERY_TERMS=vllm,my-custom-llm

# ── Metrics ────────────────────────────────────────────────────────
# Host where vLLM Prometheus metrics are published.
# On Linux Docker, host.docker.internal is mapped via extra_hosts.
# For host-network mode, use 127.0.0.1.
VLLM_OBSERVER_METRICS_HOST=host.docker.internal

# Optional: override the metrics URL for a specific instance.
# VLLM_OBSERVER_METRICS_URL_GLM52_V20_R7_EXL3=http://192.168.0.213:5810/metrics

# ── LMCache ───────────────────────────────────────────────────────
# Optional: override the LMCache HTTP API URL for a specific instance.
# VLLM_OBSERVER_LMCACHE_URL=http://127.0.0.1:8080

# ── Auth (optional) ────────────────────────────────────────────────
# VLLM_OBSERVER_AUTH_TOKEN=
# VLLM_OBSERVER_AUTH_USERNAME=
# VLLM_OBSERVER_AUTH_PASSWORD=

# ── Sampling ──────────────────────────────────────────────────────
VLLM_OBSERVER_SAMPLE_SECONDS=1
VLLM_OBSERVER_HISTORY_POINTS=3600

# ── Logs ───────────────────────────────────────────────────────────
VLLM_OBSERVER_LOG_TAIL=320
VLLM_OBSERVER_LOG_SAMPLE_SECONDS=3
VLLM_OBSERVER_LOG_HISTORY_SECONDS=604800
VLLM_OBSERVER_LOG_HISTORY_MAX_BYTES=50000000
